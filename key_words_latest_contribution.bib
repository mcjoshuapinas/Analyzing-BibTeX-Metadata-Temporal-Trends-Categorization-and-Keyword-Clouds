@article{HU2025113922,
title = {Optimizing bio-based compressed earth Blocks: Effect of sawdust on mechanical, thermal and hygroscopic performance},
journal = {Journal of Building Engineering},
volume = {112},
pages = {113922},
year = {2025},
issn = {2352-7102},
doi = {https://doi.org/10.1016/j.jobe.2025.113922},
url = {https://www.sciencedirect.com/science/article/pii/S235271022502159X},
author = {Jinxia Hu and Ryad Bouzouidja and Tingting {Vogt Wu} and Zoubir-Mehdi Sbartaï and Julie Bossu},
keywords = {CEB, Sawdust, Elastic modulus, Thermal conductivity, Building energy simulation, Hygrothermal properties},
abstract = {Increasing concerns about the environmental impact of modern construction have highlighted the potential of bio-based and raw earth materials. While conventional earth construction has largely been replaced by modern materials, renewed interest in earthen materials has emerged due to their economic and environmentally friendly benefits. This study investigates the mechanical, thermal (specific heat capacity, thermal conductivity), and hygroscopic (sorption isotherm, water vapor permeability) properties of compressed earth blocks (CEBs) with sawdust. The mechanical properties revealed a reduction in compressive strength from 17.31 to 1.95 MPa. The incorporation of 10 wt% sawdust into the CEB resulted in a nearly one-third reduction in the elastic modulus compared to that of 3 wt% sawdust. Moreover, the incorporation of sawdust improves the thermal insulation of CEB while maintaining adequate compressive strength. Furthermore, sorption and desorption data measured for raw clay bricks with sawdust between 3 and 10 wt% showed that stabilization induced a reduction in the water vapor permeability of the material between 2.3 % and 2.6 %. A key novelty of this work is identifying the most suitable formulation of CEBs for different climatic contexts and assessing its influence on heating and air-conditioning demands. To achieve this, the measured material properties were used to conduct multiple simulation at building scale under different climate conditions to estimate the heat and air-conditioning demands of concrete block and the bio-based CEB configuration. The outcomes of this study indicated that CEB combined with wood sawdust has significant potential as sustainable and energy-efficient building materials.}
}


@inproceedings{10.1007/978-3-642-36645-1_13,
	author={Favre, B{\'e}renger and Peuportier, Bruno},

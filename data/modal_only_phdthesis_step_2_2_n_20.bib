@phdthesis{blanc_etude_1991,
	address = {Paris, France},
	type = {Doctoral dissertation},
	title = {Étude du couplage dynamique de composants du bâtiment par synthèse modale},
	url = {https://theses.fr/1991ENMP0280},
	abstract = {L'objet de ce travail de recherche consiste à développer une méthode d'analyse et d'interprétation permettant de prévoir, sans simulation, l'effet de couplage de zones et de composants passifs sur le comportement d'un bâtiment. Cette méthode d'analyse du couplage des zones repose sur la synthèse modale. La technique de raccordement des modèles est basée sur le recouvrement d'une partie commune aux zones couplées. Cette analyse, à partir de cas simples de bâtiments, a permis d'identifier trois types de couplage dynamique: rapide, lent et glissant. L'analyse du couplage a également rendu possible la formulation de règles concernant la réduction de modèles locaux. L'association de la synthèse modale et de la réduction des modèles de zones a conduit à une bonne reconstitution du comportement d'un bâtiment multizone. La validation de cette approche a été conclue par la simulation du comportement thermique de bâtiments basée sur des modèles synthétisés réduits.},
	language = {fr},
	urldate = {2024-07-12},
	school = {École Nationale Supérieure des Mines de Paris},
	author = {Blanc, Isabelle},
	month = {dec},
	year = {1991},
	keywords = {thesis/yes},
}


@phdthesis{al_youssef_modelisation_1998,
	type = {Doctoral dissertation},
	title = {Modélisation de réseaux de climatisation a eau par méthode modale non réciproque},
	copyright = {Licence Etalab},
	url = {https://theses.fr/1998PA066384},
	abstract = {L'analyse modale est une methode puissante pour la modelisation et la simulation de systemes thermiques lineaires. Elle offre la possibilite de reduire les modeles de comportement, ce qui se traduit par un gain appreciable en temps de calcul et ouvre la voie a des etudes detaillees de systemes complexes tels les batiments. Lorsque ceux-ci sont munis d'equipements a caloporteurs, comme les boucles de chauffage central a eau, le systeme thermique correspondant est dit non reciproque, a cause du transport d'enthalpie qui implique un operateur de la chaleur non auto-adjoint, a elements propres complexes. Un formalisme mathematique permettant l'application de la methode modale aux systemes a transferts non reciproques a ete developpe en 1989, mais sans aucune methode robuste pour la reduction des modeles. Le travail presente dans cette these comprend deux parties principales. Dans la premiere, on reprend le formalisme mathematique de l'analyse modale non reciproque en le traduisant en une demarche systematique de modelisation, permettant le passage des equations physiques representant le comportement thermique d'un batiment muni d'equipements a caloporteurs a la simulation modale de son comportement. Deux methode puissantes de reduction de modele sont developpees : la preponderance energetique et l'amalgam modale. L'etude d'un cas test permet de valider les criteres de reduction et met en evidence la puissance de la methode modale pour la simulation thermique de batiments munis de boucles a eau. La deuxieme partie de la these consiste en l'application de la demarche developpee, dans un contexte particulier, celui du moyen-orient. Des donnees particulieres a ce contexte, concernant la nature des batiments et des equipements ainsi que le climat sont recensees. Enfin, une etude detaillee sur l'importance de la strategie de regulation des reseaux de chauffage central est effectuee sur un cas realiste. Les resultats presentent un interet pratique et montrent certaines voies de developpements futurs de la methode.},
	urldate = {2024-07-12},
	school = {Université Paris 6},
	author = {Al Youssef, Youssef},
	year = {1998},
	keywords = {thesis/yes}
}



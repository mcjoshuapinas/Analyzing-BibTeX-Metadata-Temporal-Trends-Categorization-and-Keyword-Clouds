	type = {Doctoral dissertation},
	title = {Approche théorique et expérimentale des modèles réduits du comportement thermique des bâtiments},
	url = {https://theses.fr/1989ENMP0152},
	abstract = {La description physique des phenomenes intervenant dans les lois de comportement thermique d'un batiment en regime varie met en jeu un grand nombre d'equations et de parametres thermophysiques. Toutefois, si l'on se refere a un comportement entrees-sorties, il est possible de synthetiser ces lois d'evolution a l'aide d'un nombre tres reduit d'equations et de parametres, en faisant appel a deux techniques mathematiques complementaires: la reduction de modeles, qui donne la forme theorique du modele reduit, et l'identification, qui permet d'obtenir la valeur numerique des parametres de ce modele a partir de mesures experimentales des entrees-sorties},

@phdthesis{el_khoury_formulation_1989,
	address = {Paris, France},
	type = {Doctoral dissertation},
	title = {Formulation modale de problèmes de diffusion thermique avec transport},
	url = {https://theses.fr/1989ENMP0169},
	abstract = {L'application de la methode modale a la thermique est generalisee aux systemes comprenant du transport d'energie par transfert de masse. L'ecriture des equations de comportement d'un systeme thermique lineaire conduit a la mise au jour d'un operateur spatial generalise de la chaleur. L'etude des proprietes spectrales de ce dernier qui est non-auto-adjoint met en evidence l'existence d'une base denombrable de fonctions propres associees a des valeurs propres complexes. La construction des equations d'etat modal permet d'ecrire des solutions modales formelles pour les variables d'observation. Quelques aspects theoriques de l'analyse et de la reduction des modeles modaux sont examines. Une demarche permettant le passage systematique de la theorie a la pratique, par discretisation spatiale, est expliquee. Enfin, l'utilisation de la methode modale est illustree par des exemples de systemes thermiques pris dans des domaines divers: equipements a caloporteurs, batiment, thermique industrielle et milieux poreux},
	language = {fr},
	urldate = {2025-10-08},
	school = {École Nationale Supérieure des Mines de Paris},
	author = {El Khoury, Khalil},
	year = {1989},
	keywords = {thesis/yes},
}


@phdthesis{flament_synthese_1993-1,
	address = {Paris, France},
	type = {Doctoral dissertation},
	title = {Synthèse modale de systèmes thermiques},
	url = {https://theses.fr/1993ENMP0365},
	abstract = {Nous presentons une nouvelle methode modale permettant d'etendre le champ d'application de ce type de technique aux systemes thermiques complexes multi-dimensionnels. L'idee de base repose sur le fait que ces systemes sont constitues d'une multitude de composants simples couples. Aussi, nous proposons de reconstituer les elements propre de l'operateur de la chaleur defini dans un tel systeme par sous-structuration. Pour cela on met en uvre une methode de synthese modale de type galerkin moindres carres. La technique proposee est modulaire, les fonctions locales sont calculees pour chaque composant suppose isole. Elle permet non seulement d'avoir une bonne approximation des fonctions propres globales en tout point mais aussi de controler la continuite de ces fonctions et de leur flux sur les frontieres de raccordement. Apres avoir donne un formalisme analytique de la methode, nous en effectuons une analyse a l'aide de quelques exemples simples. Deux applications concretes montrent la pertinence de la demarche adoptee},
	language = {fr},
	urldate = {2025-10-08},
	school = {École Nationale Supérieure des Mines de Paris},
	author = {Flament, Bernard},
	month = {jan},
	year = {1993},
	keywords = {thesis/yes}
}


@phdthesis{jezequel_synthese_1985,
	type = {Doctoral dissertation},
	title = {Synthèse modale : théorie et extensions},
	shorttitle = {Synthèse modale},
	url = {https://theses.fr/1985LYO19066},
	abstract = {Cette étude propose un formalisme général permettant d'englober les diverses méthodes de synthèse modale. Ainsi l'analyse de la symétrie entre les formulations primale et duale a débouché sur de nouvelles procédures. L'introduction d'opérateurs intégraux a de plus permis d'analyser leur efficacité. L'utilisation d'une famille de modes de branche autorise l'identification des modèles modaux à partir de tests vibratoires simples. Un contrôle optimal des caractéristiques de frontière a abouti à la définition de modèles très efficaces malgré le faible nombre de degrés de liberté utilisés. Les lois de comportement des matériaux et des interfaces sont présentées de façon à faire ressortir les hypothèses simplificatrices permettant d'étendre les méthodes de synthèse modale aux structures visco-élastiques et non-linéaires. En particulier on justifie l'utilisation des modes complexes et non-linéaires. Ces derniers sont rattachés à la transformation normale et leur stabilité est étudiée à l'aide de la transformation de Poincaré. Plusieurs méthodes d'identification des modèles à partir d'essais dynamiques sont exposés. De nouvelles procédures expérimentales et numériques sont proposées dans le cas de forts amortissements et de non-linéarités localisées aux interfaces. Tout au long de cette étude de nombreux résultats numériques et expérimentaux sont utilisés pour illustrer les divers développements et pour vérifier l'efficacité des diverses méthodes de synthèse modale.},
	language = {fr},
	urldate = {2025-10-08},
	school = {Lyon 1},
	author = {Jézéquel, Louis},
	year = {1985},
	keywords = {thesis/yes}
}


@phdthesis{chen_nouvelle_1989,
	address = {Paris, France},
	type = {Doctoral dissertation},
	title = {Nouvelle solution modale pour les parois des bâtiments},
	url = {https://theses.fr/1989ENMP0164},
	abstract = {Nous montrons dans la premiere partie de cette these comment les caracteristiques des differents modeles numeriques et le degre de finesse de discretisation spatiale influent sur la qualite des elements propres. Nous decrivons ensuite dans la deuxieme partie comment, grace a une technique d'assemblage (ou de synthese modale), les valeurs propres et les modes propres principaux d'un systeme thermique complet s'obtiennent a partir des elements propres de chaque composant. Nous montrons que ce calcul peut etre mene sans discretisation. Il est aussi possible d'evaluer analytiquement l'erreur due a la reduction des modeles elementaires des couches},
	language = {fr},
	urldate = {2025-10-08},
	school = {École Nationale Supérieure des Mines de Paris},
	author = {Chen, Min},
	year = {1989},
	keywords = {thesis/yes},
}



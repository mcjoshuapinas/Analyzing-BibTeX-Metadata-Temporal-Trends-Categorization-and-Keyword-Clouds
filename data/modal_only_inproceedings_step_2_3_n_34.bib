@inproceedings{blanc_bioclimatic_1991,
	address = {Denver, Colorado, United States},
	title = {A bioclimatic design aid based upon multizone simulation},
	url = {https://minesparis-psl.hal.science/hal-00520736},
	abstract = {The bioclimatic approach aims to improve comfort and to reduce the energy consumption, by distributing the solar gains over time and within the building. The corresponding architectural choices are preferably evaluated bt dynamic analysis, and the simulation approach is particularly adapted, offering a good sensitivity to the design parameters. This analysis can be performed during the architectural design only if computation time is short, and if the user can compare very easily alternative designs. Such an interactivity between simulation and design is possible with COMFIE, a simplified tool, based on a powerful method, the modal analysis which is now presented. The design of a sunspace, transparent insulation and the evaluation of comfort conditions are shown as examples of such interactivity between simulation and design.},
	urldate = {2026-02-12},
	booktitle = {Solar {World} {Congress} - {Proceedings} of the {ISES} {Solar} {World} {Congress}},
	publisher = {Elsevier Science \& Technology Books},

@inproceedings{bs2013_1266,
	doi = {https://doi.org/10.26868/25222708.2013.1266},
	url = {https://publications.ibpsa.org/conference/paper/?id=bs2013_1266},
	year = {2013},
	month = {August},
	publisher = {IBPSA},
	author = {Fabio MUNARETTO and  Bruno PEUPORTIER and  Alain GUIAVARCH},
	title  = {Accounting For Thermal Mass In Thermal Simulation Tools: Comparison Of Several Assumptions},
	booktitle = {Proceedings of Building Simulation 2013: 13th Conference of IBPSA},
	volume  = {13},
	isbn = {978-2-7466-6294-0 },
	address  = {Chambery, France},
	series  = {Building Simulation},
	pages = {2700--2707},
	abstract = {Being highly insulated, low energy buildings are very sensitive to  variable solar  and  internal  gains.  In this context,  thermal  mass  is  useful  in  storing  surplus energy,     reducing     temperature     variations     and improving    thermal    comfort.    Thus,    conduction modelling    is    fundamental,    but    not    sufficient: appropriate superficial heat transfer modelling is also needed.   Therefore,   several   common   simplifying assumptions  have  been  investigated  and  adapted  to the   case   of   high   performance   buildings.   These models are reassessed using the BESTEST numerical building   simulations   and   compared   to   reference models.},
	issn = {2522-2708},
	Organisation = {IBPSA},
	Editors = {Etienne Wurtz}
}



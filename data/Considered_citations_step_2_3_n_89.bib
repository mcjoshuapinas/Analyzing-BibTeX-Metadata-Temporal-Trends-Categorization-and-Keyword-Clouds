@article{YAHIA1999447,
title = {Thermal systems modelling via singular value decomposition: direct and modular approach},
journal = {Applied Mathematical Modelling},
publisher = {Elsevier},
volume = {23},
number = {6},
pages = {447-468},
year = {1999},
issn = {0307-904X},
doi = {https://doi.org/10.1016/S0307-904X(98)10091-4},
url = {https://www.sciencedirect.com/science/article/pii/S0307904X98100914},
author = {Ali Ait Yahia and Elena Palomo Del Barrio},
keywords = {Thermal systems, Singular value decomposition, Model reduction, Modular modelling, Simulation},
abstract = {Singular Value Decomposition (SVD) technique consists of obtaining the decomposition of a given matrix M=UMΣMVM∗ where UM and VM are unitary matrices and ΣM is a matrix of the same size as M with nonnegative real diagonal entries which are called singular values or principal values. We show in this article that if M is the gramian matrix of the temperature field of a thermal system, a small number of columns of UM, associated to the greatest singular values, used as a basis to project the temperature field, allows us to reconstitute an accurate solution of the heat transfer problem. Thus the number of differential equations to resolve in order to simulate or to control the evolution of the temperature field is drastically reduced. A bound of the spectral norm of the introduced error is derived. The method is applied to reduce a model of thermal bridge, and in a modular approach to reduce a model of a multizones building.}
}


@article{ELBIYAALI1996575,
title = {Sous-structuration et couplage de modeles reduits appliques aux transferts thermiques dans le sol},
journal = {International Communications in Heat and Mass Transfer},
publisher = {Elsevier},
volume = {23},
number = {4},
pages = {575-586},
year = {1996},
issn = {0735-1933},
doi = {https://doi.org/10.1016/0735-1933(96)00041-3},
url = {https://www.sciencedirect.com/science/article/pii/0735193396000413},
author = {A. {El Biyaali} and J.J. Roux and C. Inard},
abstract = {State models are often used in order to simulate the thermal behaviour of buildings. If this method presents numerous advantages for example with respect to the management of the simulation time step, we have to handle an important system of differential equations when we consider a large thermal domain. So, in order to reduce these systems, one often use the modal reduction. In this paper, we present a method using sub-structuration and local model reduction which allows us to reduce the system to solve. We have illustrated this method with a typical case which is the evaluation of heat transfer between a building and its surrouding ground. comparison between the detailled formulation of the problem, the well knowed linear aggregation reduction and the sub-structuration method shows that the results are close each other.}
}



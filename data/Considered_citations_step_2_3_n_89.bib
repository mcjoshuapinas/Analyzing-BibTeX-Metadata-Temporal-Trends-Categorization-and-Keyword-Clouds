@article{videcoq_comparison_2006,
	title = {Comparison of {Two} {Nonlinear} {Model} {Reduction} {Techniques}: {The} {Modal} {Identification} {Method} and the {Branch} {Eigenmodes} {Reduction} {Method}},
	volume = {49},
	issn = {1040-7790},
	shorttitle = {Comparison of {Two} {Nonlinear} {Model} {Reduction} {Techniques}},
	url = {https://doi.org/10.1080/10407790500344035},
	doi = {https://doi.org/10.1080/10407790500344035},
	abstract = {This article shows the comparison of two modal reduction techniques, the modal identification method and the branch eigenmodes reduction method. The objective of these methods is to reduce the number of states representing the system evolution in order to decrease the computational time necessary for the simulation. After a presentation of both techniques, a comparison is made on a 3-D nonlinear transient thermal diffusive system. Results given by the two reduced models are compared to those given by the detailed model. The accuracy of both reduced models, as well as the gain in computational time, are analyzed for each configuration.},

@article{WOS:A1991FG69600004,
	Author = {BAUDIER, M and MARCHIO, D},
	title = {DYNAMIC-MODEL IDENTIFICATION APPLIED TO THE MEASURING OF THERMAL STATIC
   CHARACTERISTICS OF BUILDINGS},
